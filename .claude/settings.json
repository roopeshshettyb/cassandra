{
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npx tsc:*)",
      "Bash(npm install:*)",
      "Bash(npx ts-node:*)",
      "Bash(netstat -ano)",
      "Bash(findstr \":3000\")",
      "Bash(cmd /c \"taskkill /PID 41528 /F\")",
      "Bash(cmd /c \"netstat -ano | findstr :3000\")",
      "Bash(cmd /c \"taskkill /PID 41528 /F 2>&1\")",
      "Bash(cmd /c \"netstat -ano | findstr :3000 2>&1\")",
      "Read(//tmp/**)",
      "Bash(cmd /c \"netstat -ano | findstr :7676 2>&1\")",
      "Bash(cmd /c 'netstat -ano')",
      "Bash(echo \"Not found via bash grep\" cmd /c \"netstat -ano 2>&1\")",
      "Bash(cmd /c \"powershell -command \"\"Get-NetTCPConnection -LocalPort 7676 -ErrorAction SilentlyContinue | Format-Table -AutoSize\"\"\")",
      "Bash(cmd /c \"powershell -command \"\"Get-Process -Name node -ErrorAction SilentlyContinue | Select-Object Id,ProcessName,CPU | Format-Table\"\"\")",
      "Bash(cmd /c \"netsh interface ipv4 show excludedportrange protocol=tcp\")",
      "Bash(cmd /c \"netsh int ipv4 show excludedportrange protocol=tcp\")",
      "Bash(echo \"exit: $?\")",
      "Bash(powershell -command \"Get-NetTCPConnection | Where-Object {$_LocalPort -eq 7676} | Format-Table -AutoSize\")",
      "Bash(powershell -command 'Get-NetTCPConnection | Where-Object LocalPort -EQ 7676 | Format-Table -AutoSize')",
      "Bash(powershell -command 'Get-Process -Id 46596 | Format-Table Id,ProcessName,Path -AutoSize')",
      "Bash(powershell -command \"Stop-Process -Id 46596 -Force\")",
      "Bash(powershell -command \"Test-NetConnection -ComputerName localhost -Port 7676 -InformationLevel Quiet -WarningAction SilentlyContinue\")"
    ]
  }
}
