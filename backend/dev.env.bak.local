# ── Chat Context Summarization (single rolling summary + raw tail) ──
ENABLE_CONTEXT_SUMMARY=true
SUMMARY_MODEL=openai/gpt-4o-mini
CONTEXT_SUMMARY_TRIGGER_TOKENS=4000
CONTEXT_RAW_TAIL_COUNT=5

# ── LLM Eval (LLM-as-judge quality scoring) ────────────────────────────────
# LLM_EVAL_ENABLED=true|false       → master switch for all eval dimensions
# LLM_EVAL_SAMPLE_RATE=0.0–1.0      → fraction of chat/voice turns graded (0.1 = 10%)
# LLM_EVAL_TASK_SAMPLE_RATE=0.0–1.0 → fraction of summaries/titles/extractions/OCR graded (0.3 = 30%)
LLM_EVAL_ENABLED=true
LLM_EVAL_SAMPLE_RATE=0.1
LLM_EVAL_TASK_SAMPLE_RATE=0.3

# ── Voice Pipeline ─────────────────────────────────────────────────────────
# VOICE_PIPELINE=gpt      → OpenAI Realtime API (single model handles STT+LLM+TTS)
# VOICE_PIPELINE=deepgram → Deepgram Voice Agent (STT+LLM+TTS via Deepgram WebSocket)
# VOICE_PIPELINE=custom   → Custom pipeline: STT provider → LLM (OpenRouter) → TTS provider
VOICE_PIPELINE=gpt
OPENAI_REALTIME_MODEL=gpt-realtime-2

# ── Deepgram Voice Agent (used when VOICE_PIPELINE=deepgram) ───────────────
# DEEPGRAM_AGENT_LISTEN_MODEL=nova-3          (default)
# DEEPGRAM_AGENT_THINK_PROVIDER=open_ai       (default)
# DEEPGRAM_AGENT_THINK_MODEL=gpt-4o-mini      (default)
# DEEPGRAM_AGENT_SPEAK_MODEL=aura-2-thalia-en (default)

# STT provider (used only when VOICE_PIPELINE=custom): openai | deepgram
OPENAI_STT_SILENCE_MS=1200

