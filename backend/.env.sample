# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (AWS RDS PostgreSQL)
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=5432
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password
DB_NAME=profileaura
DB_SSL=true
DB_POOL_SIZE=5

# AWS Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-bucket-name

# JWT Configuration
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRY_DAYS=7

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# The frontend dev server's origin (frontend/nodemon.json runs it on 7678), not this API's
# port. It is the API's only CORS origin — a wrong value here breaks local browser calls.
FRONTEND_URL=http://localhost:7678

# White-labeling Configuration
# Every value below has a working default in constants.service.ts — set them only to rebrand.
# Set these in the real environment (backend/.env, or Amplify/pm2 config), not in this sample file.
#
# NOTE: the frontend bakes these in at BUILD time. `npm run build` runs fetch-constants first,
# which pulls /constants/public from REACT_APP_BACKEND_URL and rewrites frontend/src/constants.json,
# so a frontend redeploy alone picks up a change made here. Two consequences: the frontend build
# fails if this backend is unreachable, and `npm start` refreshes constants.json but does not
# rewrite index.html — the dev tab title stays whatever is committed in public/index.html.
APP_NAME=Samantha
TAGLINE=With you, always
DESCRIPTION=Samantha is your personal concierge and will make your stay a breeze.
# Square logo. Used for the tab favicon, the iOS home-screen icon and push notifications.
LOGO=https://flashpact-public-bucket.s3.ap-south-1.amazonaws.com/samantha_logo.jpg
# Social share image (og:image / twitter:image).
HERO=https://flashpact-public-bucket.s3.ap-south-1.amazonaws.com/samantha_logo.jpg
# Public site URL. Used for the og:url share tag.
PROD_FRONTEND_URL=https://samantha.flashpact.in
CALENDLY_DEMO_URL=https://calendly.com/roopesh-flashpact/samantha-demo
# YouTube video id embedded in the landing page demo section.
LANDING_DEMO_YOUTUBE_ID=I9_GFTV5P2w
# PWA identity. Changing PWA_ID makes browsers treat it as a different installable app.
PWA_ID=/samantha-concierge
# Quote hex colours — an unquoted leading # is parsed as a comment and yields an empty value.
THEME_COLOR="#1B2340"
# PWA install icons. Bare filenames resolve inside frontend/public/; absolute URLs also work.
PWA_ICON_192=logo192.png
PWA_ICON_512=logo.png
# Landing page hero video and poster. Bare filenames resolve inside frontend/public/; absolute URLs also work.
LANDING_HERO_VIDEO=landingpage-hero.mp4
LANDING_HERO_POSTER=landingpage-hero-poster.png
# App UI palette and font. A hotel that configures its own theme overrides these; they are what
# an unconfigured deployment looks like. Quote hex colours — an unquoted # starts a comment.
THEME_PRIMARY_COLOR="#D4AF37"
THEME_SECONDARY_COLOR="#C5A022"
THEME_NAVY_COLOR="#1B2340"
THEME_NAVY_LIGHT_COLOR="#263462"
THEME_PRIMARY_HOVER_COLOR="#B8860B"
THEME_BACKGROUND_DEFAULT_LIGHT="#F8F7F4"
THEME_BACKGROUND_DEFAULT_DARK="#000000"
THEME_BACKGROUND_PAPER_LIGHT="#FFFFFF"
THEME_BACKGROUND_PAPER_DARK="#121212"
THEME_FONT_FAMILY='"Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", "Roboto", sans-serif'
# Prefix applied to every private-bucket object key, e.g. jessie/
AWS_S3_KEY_PREFIX=samantha/

# AI Assistant (text agent uses gpt-4o-mini)
OPENAI_API_KEY=your-openai-api-key

# Voice LLM pipeline for real-time voice mode:
# - custom (default): use existing STT → LangGraph LLM → TTS pipeline
# - gpt: use OpenAI GPT Realtime as the LLM (STT/TTS still via existing providers)
VOICE_PIPELINE=custom
