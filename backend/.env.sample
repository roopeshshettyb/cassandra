# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (AWS RDS PostgreSQL)
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=5432
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password
DB_NAME=profileaura
DB_SSL=true
DB_POOL_SIZE=5
# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (AWS RDS PostgreSQL)
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=5432
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password
DB_NAME=profileaura
DB_SSL=true
DB_POOL_SIZE=5

# AWS Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-bucket-name

# JWT Configuration
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRY_DAYS=7

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
FRONTEND_URL=http://localhost:3000

# White-labeling Configuration
APP_NAME=Profile Aura
TAGLINE=With you, always
DESCRIPTION=Profile Aura is your personal concierge and will make your stay a breeze.
LOGO=https://your-bucket.s3.your-region.amazonaws.com/your-logo.jpg
HERO=https://your-bucket.s3.your-region.amazonaws.com/your-hero.jpg
PROD_FRONTEND_URL=https://your-domain.com
CALENDLY_DEMO_URL=https://calendly.com/your-org/your-demo
# Comma-separated list of extra origins allowed to upload to S3 (localhost is always allowed)
AWS_S3_CORS_ORIGINS=https://your-domain.com,https://your-stage-domain.com

# AI Assistant (text agent uses gpt-4o-mini)
OPENAI_API_KEY=your-openai-api-key

# Voice LLM pipeline for real-time voice mode:
# - custom (default): use existing STT → LangGraph LLM → TTS pipeline
# - gpt: use OpenAI GPT Realtime as the LLM (STT/TTS still via existing providers)
VOICE_PIPELINE=custom
# AWS Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-bucket-name

# JWT Configuration
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRY_DAYS=7

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
FRONTEND_URL=http://localhost:3000

# White-labeling Configuration
APP_NAME=Profile Aura

# AI Assistant (text agent uses gpt-4o-mini)
OPENAI_API_KEY=your-openai-api-key

# Voice LLM pipeline for real-time voice mode:
# - custom (default): use existing STT → LangGraph LLM → TTS pipeline
# - gpt: use OpenAI GPT Realtime as the LLM (STT/TTS still via existing providers)
VOICE_PIPELINE=custom
