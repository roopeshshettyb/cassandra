{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Nest: attach 9229 (watch — use with npm run start:debug)",
      "type": "pwa-node",
      "request": "attach",
      "port": 9229,
      "address": "127.0.0.1",
      "restart": true,
      "cwd": "${workspaceFolder}/backend",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/backend/dist/**/*.js"],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/backend/**",
        "!**/node_modules/**"
      ]
    }
  ]
}
